{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Panel Configuration",
  "description": "Configuration schema for UI panel creation",
  "type": "object",
  "properties": {
    "panelName": {
      "type": "string",
      "description": "The name of the panel GameObject",
      "minLength": 1
    },
    "includeHeader": {
      "type": "boolean",
      "description": "Whether to include a header section",
      "default": true
    },
    "includeCloseButton": {
      "type": "boolean",
      "description": "Whether to include a close button",
      "default": true
    },
    "width": {
      "type": "number",
      "description": "Panel width in pixels",
      "minimum": 100,
      "maximum": 1920,
      "default": 400
    },
    "height": {
      "type": "number",
      "description": "Panel height in pixels",
      "minimum": 100,
      "maximum": 1080,
      "default": 300
    },
    "backgroundColor": {
      "type": "object",
      "description": "Panel background color (RGBA)",
      "properties": {
        "r": { "type": "number", "minimum": 0, "maximum": 1 },
        "g": { "type": "number", "minimum": 0, "maximum": 1 },
        "b": { "type": "number", "minimum": 0, "maximum": 1 },
        "a": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "default": { "r": 0.1, "g": 0.1, "b": 0.1, "a": 0.9 }
    },
    "headerHeight": {
      "type": "number",
      "description": "Header height in pixels",
      "minimum": 20,
      "maximum": 100,
      "default": 40
    },
    "padding": {
      "type": "number",
      "description": "Content padding in pixels",
      "minimum": 0,
      "maximum": 50,
      "default": 10
    }
  },
  "required": ["panelName"]
}
